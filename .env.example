# Variables del build (opcionales). Copia a .env si las necesitas en local; CI las define por su cuenta.
# Ruta pública del sitio: "/" en icatacama.com; "/<repositorio>/" en GitHub Pages de proyecto.
BASE_PATH=/
# "production" (por defecto) o "preview" (copia de revisión: noindex, robots.txt cerrado, sin sitemap).
SITE_ENV=production
# Para npm run deploy (salidas de la pila de CloudFormation).
S3_BUCKET=
CLOUDFRONT_DISTRIBUTION_ID=
